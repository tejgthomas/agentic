[Unit]
Description=UM EECS Agentic harnessd
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=1
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/agentic/harnessd

SecureBits=keep-caps
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

EnvironmentFile=/home/ubuntu/.env.sys

ExecStart=/home/ubuntu/agentic/harnessd/.venv/bin/python3 -u harnessd.py

[Install]
WantedBy=multi-user.target
